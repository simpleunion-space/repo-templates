{
  "schemaVersion": 2,
  "id": "net",
  "parentProfile": "base",
  "requiredBaseSchemaVersion": 2,
  "requiredParentSchemaVersion": 2,
  "requiredTokens": [
    "PROJECT_NAME",
    "PROJECT_SLUG",
    "DOTNET_SDK_VERSION",
    "TARGET_FRAMEWORK"
  ],
  "fragments": [
    {
      "source": "fragments/.gitignore",
      "target": ".gitignore"
    },
    {
      "source": "fragments/.editorconfig",
      "target": ".editorconfig"
    }
  ],
  "removePaths": [
    "src/.gitkeep",
    "tests/.gitkeep"
  ],
  "pathRequirements": [
    { "path": "build", "kind": "directory", "status": "required" },
    { "path": "build/{{PROJECT_NAME}}.Core", "kind": "directory", "status": "required" },
    { "path": "build/{{PROJECT_NAME}}.Core/.gitkeep", "kind": "file", "status": "required" }
  ]
}
